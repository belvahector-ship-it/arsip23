# Kredensial — TIDAK BOLEH masuk repo, apa pun alasannya.
# Key service account Google memberi akses tulis penuh ke Drive Bersama arsip;
# sekali ter-push ke repo publik ia harus dianggap bocor selamanya, karena
# riwayat git menyimpannya meski berkasnya dihapus di commit berikutnya.
*.pem
*-key.json
client_secret*.json
service-account*.json
.dev.vars
.env
.env.*

# Cloudflare
worker/.wrangler/
worker/node_modules/
node_modules/

# OS & editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Perkakas pengujian desain lokal — SENGAJA tidak diterbitkan.
#
# preview-desain.html memuat seluruh komponen dengan data palsu supaya tema
# bisa dinilai tanpa login Google. Kalau ia ikut ke `main`, ia ikut terbit ke
# arsip-gratis.my.id/preview-desain.html: publik, terindeks mesin pencari, dan
# memperlihatkan "3 folder · 4 berkas" palsu sebagai kalau itu isi arsip
# sungguhan. Berkasnya tetap ada di cakram untuk dipakai lagi kapan pun.
preview-desain.html
.claude/launch.json
